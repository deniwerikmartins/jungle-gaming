{
  "name": "jungle-gaming-wagering-processor",
  "version": "1.0.0",
  "description": "Distributed Wagering Processor — Jungle Gaming Technical Challenge",
  "private": true,
  "scripts": {
    "build": "bun build src/main.ts --outdir dist --target bun",
    "start": "bun run dist/main.js",
    "start:dev": "bun run --watch src/main.ts",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:load": "bun run test/load/run.ts",
    "migration:run": "bun run src/infrastructure/database/migrations/run.ts",
    "migration:revert": "bun run src/infrastructure/database/migrations/revert.ts",
    "migration:generate": "bun run src/infrastructure/database/migrations/generate.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.637.0",
    "@mikro-orm/core": "6.3.13",
    "@mikro-orm/migrations": "6.3.13",
    "@mikro-orm/nestjs": "6.0.2",
    "@mikro-orm/postgresql": "6.3.13",
    "@mikro-orm/reflection": "6.3.13",
    "@nestjs/common": "10.4.4",
    "@nestjs/core": "10.4.4",
    "@nestjs/platform-fastify": "10.4.4",
    "@nestjs/schedule": "4.1.1",
    "@nestjs/terminus": "10.2.3",
    "decimal.js": "10.4.3",
    "fastify": "4.28.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "uuid": "11.0.5"
  },
  "devDependencies": {
    "@types/node": "22.7.4",
    "@types/uuid": "11.0.0",
    "bun-types": "1.1.29",
    "typescript": "5.6.2"
  },
  "trustedDependencies": [
    "@mikro-orm/core"
  ]
}
