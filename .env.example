# Application
NODE_ENV=development
APP_PORT=3000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wagering
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering_secret

DATABASE_URL=postgresql://wagering:wagering_secret@postgres:5432/wagering

# LocalStack / AWS SQS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
SQS_QUEUE_URL=http://localstack:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localstack:4566/000000000000/wager-transactions-dlq.fifo

# Workers
OUTBOX_POLL_INTERVAL_MS=2000
SQS_POLL_WAIT_SECONDS=20
SQS_MAX_MESSAGES=10
PENDING_REFERENCE_MAX_RETRIES=5
GRACEFUL_SHUTDOWN_TIMEOUT_MS=30000
